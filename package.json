{
    "name": "frontend-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run build-tailwind-config && vite",
        "build": "npm run build-tailwind-config && vite build",
        "watch": "npm run build-tailwind-config && vite build --watch",
        "preview": "vite preview",
        "test:unit": "vitest run --environment jsdom",
        "lint": "eslint 'src/**/*.{js,vue}'",
        "lint:fix": "eslint 'src/**/*.{js,vue}' --fix",
        "build-tailwind-config": "node tailwindConfigToJson.cjs"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "axios": "^1.7.2",
        "axios-mock-adapter": "^1.22.0",
        "broadcast-channel": "^7.0.0",
        "vue": "^3.5.13",
        "vue-i18n": "^11.1.11",
        "vue-router": "^4.4.0",
        "vuetify": "^3.12.0",
        "vuex": "^4.1.0",
        "webfontloader": "^1.6.28"
    },
    "devDependencies": {
        "@babel/eslint-parser": "^7.24.1",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.5",
        "autoprefixer": "^10.4.13",
        "eslint": "^9.7.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-vue": "^9.25.0",
        "globals": "^15.11.0",
        "jsdom": "^24.0.0",
        "postcss": "^8.4.21",
        "postcss-import": "^16.1.0",
        "prettier": "^3.3.2",
        "prettier-plugin-tailwindcss": "^0.6.5",
        "tailwindcss": "^3.2.6",
        "vite": "^7.3.0",
        "vite-plugin-vue-devtools": "^7.3.5",
        "vite-svg-loader": "^5.1.0",
        "vitest": "^3.2.0",
        "vue-eslint-parser": "^9.4.3"
    }
}
